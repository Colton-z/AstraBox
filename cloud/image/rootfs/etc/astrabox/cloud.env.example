# Settings astrabox-first-boot reads from /etc/astrabox/cloud.env on the first
# boot. Write that file from cloud-init user data or a marketplace template
# before the first boot finishes; every line is optional.
# https://www.astrabox.ai/docs/cloud-images

# The model service the seeded Agents use. Without these, add one in the
# console under Integrated services > LiteLLM gateway.
#   anthropic, deepseek, anthropic-compatible, openai-compatible or none
#ASTRABOX_INSTALL_MODEL_PROVIDER=deepseek
#ASTRABOX_INSTALL_MODEL_API_KEY=
#ASTRABOX_INSTALL_MODEL_NAME=
#   For an *-compatible service only:
#ASTRABOX_INSTALL_MODEL_BASE_URL=

# Two host names whose DNS records point at this machine: the console, and the
# sign-in pages. Without them, the console is served at https://<public IP>
# and the sign-in pages at https://<public IP>:8443.
#ASTRABOX_CONSOLE_DOMAIN=astrabox.example.com
#ASTRABOX_LOGIN_DOMAIN=login.example.com

# The address browsers use, when the machine cannot find its public IPv4
# address itself.
#ASTRABOX_PUBLIC_ADDRESS=203.0.113.10

# acme (default): a Let's Encrypt certificate, with a self-signed fallback.
# internal: a self-signed certificate only.
#ASTRABOX_TLS=acme
#ASTRABOX_ACME_EMAIL=you@example.com
