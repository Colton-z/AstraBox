ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY --chmod=u=rwX,go=rX tests/e2e/fixtures/runtime_preparation/environment-plugin /opt/prewarm-session-environment-marketplace/plugins/prewarm-session-environment
COPY --chmod=u=rwX,go=rX tests/e2e/fixtures/runtime_preparation/environment-marketplace.json /opt/prewarm-session-environment-marketplace/.claude-plugin/marketplace.json
RUN install -d -m 0700 -o 1000 -g 1000 /home/agent && \
    HOME=/home/agent CLAUDE_CONFIG_DIR=/home/agent/.claude \
    /usr/local/bin/claude plugin install prewarm-session-environment \
    --marketplace /opt/prewarm-session-environment-marketplace --scope user --yes --json && \
    chown -R 1000:1000 /home/agent
