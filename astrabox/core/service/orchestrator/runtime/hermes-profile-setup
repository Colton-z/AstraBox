#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf 'usage: %s <workspace-source>\n' "$0" >&2
  exit 64
fi

required() {
  name="$1"
  value="${!name:-}"
  if [ -z "$value" ]; then
    printf 'HERMES_PROFILE_ENV_MISSING name=%s\n' "$name" >&2
    exit 64
  fi
  printf '%s' "$value"
}

linux_user="$(required ASTRABOX_HERMES_PROFILE_LINUX_USER)"
profile_home="$(required ASTRABOX_HERMES_PROFILE_HOME)"
workspace="$(required ASTRABOX_HERMES_WORKSPACE)"
workspace_source="$1"
hermes_home="$(required HERMES_HOME)"

case "$workspace_source" in
  "$profile_home"/*) ;;
  *)
    printf 'HERMES_PROFILE_WORKSPACE_SOURCE_INVALID source=%s home=%s\n' \
      "$workspace_source" "$profile_home" >&2
    exit 65
    ;;
esac

runuser -u "$linux_user" -- mkdir -p "$workspace_source" "$hermes_home/logs" "$hermes_home/plugins"
# Hermes installs native plugins as the profile account. The common CLI
# bootstrap creates this root as a platform constraint; Hermes needs it mutable.
if [ -L "$hermes_home/plugins" ]; then
  printf 'HERMES_PROFILE_PLUGIN_ROOT_INVALID path=%s\n' "$hermes_home/plugins" >&2
  exit 68
fi
chown -h "$linux_user:$linux_user" "$hermes_home/plugins"

if [ "$workspace" != "$workspace_source" ]; then
  if [ -L "$workspace" ]; then
    if [ "$(readlink "$workspace")" != "$workspace_source" ]; then
      printf 'HERMES_PROFILE_WORKSPACE_ALIAS_MISMATCH visible=%s expected=%s actual=%s\n' \
        "$workspace" "$workspace_source" "$(readlink "$workspace")" >&2
      exit 66
    fi
  elif [ -e "$workspace" ]; then
    printf 'HERMES_PROFILE_WORKSPACE_ALIAS_OCCUPIED visible=%s source=%s\n' \
      "$workspace" "$workspace_source" >&2
    exit 66
  else
    ln -s -- "$workspace_source" "$workspace"
  fi
fi

# The owner's Hermes configuration lives in Hermes' managed scope
# (`hermes_cli/managed_scope.py`), which wins over the profile's config.yaml
# key by key. Root-owned, so the agent reads it and cannot change it; without
# an owner configuration the scope holds nothing.
managed_dir="$(required HERMES_MANAGED_DIR)"
install -d -o root -g root -m 0755 "$managed_dir"
if [ -n "${ASTRABOX_HERMES_MANAGED_CONFIG:-}" ]; then
  managed_tmp="$(mktemp "$managed_dir/.config.yaml.XXXXXX")"
  "$HERMES_VENV/bin/python" -c '
import json, os, sys
import hermes_yaml as yaml
config = json.loads(os.environ["ASTRABOX_HERMES_MANAGED_CONFIG"])
overwrite = json.loads(os.environ.get("ASTRABOX_HERMES_CONFIG_OVERWRITE") or "{}")
agent = config.get("agent")
if "a2a_agents" in overwrite and isinstance(agent, dict) and "disabled_toolsets" in agent:
    from agent.skill_utils import parse_config_string_list
    agent["disabled_toolsets"] = [
        name for name in parse_config_string_list(agent["disabled_toolsets"])
        if name.strip() != "a2a"
    ]
sys.stdout.write(yaml.safe_dump(config, sort_keys=False, allow_unicode=True))
' > "$managed_tmp"
  chmod 0644 "$managed_tmp"
  mv -f -- "$managed_tmp" "$managed_dir/config.yaml"
else
  rm -f -- "$managed_dir/config.yaml"
fi

# Identity provisioning owns the profile roots; native files stay owned by
# Hermes, and the platform publishes its private files with an explicit owner.
# A running profile's snapshot and PM workers may remove temporary files here.
if ! runuser -u "$linux_user" -- test -w "$workspace"; then
  printf 'HERMES_PROFILE_WORKSPACE_NOT_WRITABLE user=%s workspace=%s source=%s\n' \
    "$linux_user" "$workspace" "$workspace_source" >&2
  exit 67
fi
printf 'HERMES_PROFILE_READY user=%s workspace=%s source=%s\n' \
  "$linux_user" "$workspace" "$workspace_source"
