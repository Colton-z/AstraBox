#!/usr/bin/env bash
# AstraBox — run Hermes' gateway daemon inside the sandbox, as a service of the image.
#
# `hermes gateway run` is Hermes' session owner: it holds every conversation of
# the profile, the durable admission ledger in `state.db` that makes a
# re-submitted input id the same admission, and the cron ticker that runs the
# profile's scheduled jobs. Its clients speak the canonical `hermes-gateway-v1`
# WebSocket protocol, the one Hermes' own TUI and desktop app use. The image
# owns the process from boot, so a resumed box comes back with its engine
# instead of waiting for someone's first message to start one.
#
# Three supervised programs run this script (supervisord.hermes.conf):
#
#   (no argument)  the gateway daemon
#   --mirror       the state mirror that saves `state.db` and the profile
#   --bridge       hermes_gateway_bridge.py, which publishes the daemon on the
#                  box's outward port for the platform host
set -euo pipefail

mode=daemon
if [ "${1:-}" = "--mirror" ] && [ "$#" -eq 1 ]; then
  mode=mirror
elif [ "${1:-}" = "--bridge" ] && [ "$#" -eq 1 ]; then
  mode=bridge
elif [ "$#" -ne 0 ]; then
  printf 'astrabox-hermes-serve: expected no arguments, --mirror or --bridge\n' >&2
  exit 64
fi

# The port the bridge publishes; the Hermes adapter's HERMES_BACKEND_PORT names
# the same one (astrabox/core/service/orchestrator/engine/hermes.py).
LISTEN_PORT="${ASTRABOX_HERMES_LISTEN_PORT:-9118}"
# How long the bridge waits for the daemon's first readiness before it gives up.
DAEMON_WAIT_SECONDS="${ASTRABOX_HERMES_UPSTREAM_WAIT_SECONDS:-1800}"

# ── waiting for the profile ──────────────────────────────────────────────
#
# A Hermes profile is one (user, assistant) pair: its home, its Linux account,
# its model route. None of that exists when the box is created — the host
# writes this file after identity provisioning — so this service waits for it
# rather than starting Hermes against the image's empty default profile.
#
# The profile may come from an optional workspace mount. Its old env is not
# initialization evidence for a new box: the platform must publish the current
# box's gate under /run before this service can restore native state and start.
# One level under the root, matching `hermes_runtime_profile`'s `home_template`.
PROFILE_GLOB="/home/conversations/*/.hermes/astrabox-hermes.env"
DEADLINE_SECONDS="${ASTRABOX_HERMES_PROFILE_WAIT_SECONDS:-1800}"

# The env file appears before the workspace directory it names does, so the
# wait covers everything the launcher below dereferences: a service started on
# the file alone fails on a directory provisioning has not created yet, and
# supervisord's restarts would stand in for a wait.
profile_ready() {
  local env_file="$1"
  "${HERMES_VENV}/bin/python" /opt/astrabox/hermes/hermes_state_bootstrap.py \
    ready --profile-env "$env_file" || return $?
  if [ "$mode" = mirror ]; then
    "${HERMES_VENV}/bin/python" /opt/astrabox/hermes/hermes_state_mirror.py \
      ready --profile-env "$env_file" || return $?
  fi
  # shellcheck disable=SC1090
  ( source "$env_file" >/dev/null 2>&1 \
    && [ -n "${ASTRABOX_HERMES_PROFILE_LINUX_USER:-}" ] \
    && [ -n "${ASTRABOX_HERMES_PROFILE_HOME:-}" ] \
    && [ -n "${ASTRABOX_HERMES_WORKSPACE:-}" ] \
    && [ -n "${HERMES_DASHBOARD_SESSION_TOKEN:-}" ] \
    && [ -d "$ASTRABOX_HERMES_PROFILE_HOME" ] \
    && [ -d "$ASTRABOX_HERMES_WORKSPACE" ] \
    && id -u "$ASTRABOX_HERMES_PROFILE_LINUX_USER" >/dev/null 2>&1 )
}

profile_env=""
waited_for_workspace=0
deadline=$(( $(date +%s) + DEADLINE_SECONDS ))
while :; do
  # shellcheck disable=SC2086
  matches=( $(compgen -G "$PROFILE_GLOB" || true) )
  if [ "${#matches[@]}" -gt 1 ]; then
    # One box carries one Assistant workspace. Two profiles here means the box
    # is serving something this design does not describe, and starting Hermes
    # against an arbitrary one of them would bind the wrong account.
    printf 'astrabox-hermes-serve: %d profiles under %s; refusing to guess\n' \
      "${#matches[@]}" "$PROFILE_GLOB" >&2
    exit 78
  fi
  if [ "${#matches[@]}" -eq 1 ]; then
    if profile_ready "${matches[0]}"; then
      profile_env="${matches[0]}"
      break
    else
      ready_status=$?
      if [ "$ready_status" -ne 1 ]; then
        exit "$ready_status"
      fi
    fi
    # Said once rather than every second: a line per poll would bury the
    # readiness line this service exists to print.
    if [ "$waited_for_workspace" -eq 0 ]; then
      waited_for_workspace=1
      printf 'astrabox-hermes-serve: profile env present, waiting for the '
      printf 'current-box initialization, account and directories (%s)\n' "${matches[0]}"
    fi
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    printf 'astrabox-hermes-serve: no usable profile at %s after %ss\n' \
      "$PROFILE_GLOB" "$DEADLINE_SECONDS" >&2
    exit 75
  fi
  sleep 1
done

printf 'ASTRABOX_HERMES_PROFILE_FOUND path=%s\n' "$profile_env"

# The file is the host's, and it already exports everything the launcher needs:
# the Linux account, the profile home, the workspace, the model route, and the
# credential the bridge checks the host's upgrade against.
# shellcheck disable=SC1090
source "$profile_env"

: "${ASTRABOX_HERMES_PROFILE_LINUX_USER:?profile env names no Linux user}"
: "${ASTRABOX_HERMES_PROFILE_HOME:?profile env names no profile home}"
: "${ASTRABOX_HERMES_WORKSPACE:?profile env names no workspace}"
: "${HERMES_DASHBOARD_SESSION_TOKEN:?profile env carries no bridge credential}"

log_dir="${ASTRABOX_HERMES_PROFILE_HOME}/.hermes/logs"
mkdir -p "$log_dir"

# The profile env is sourced again INSIDE the workload account's shell, and
# every variable in it reaches the program started there. Naming a few by hand
# instead would start a gateway with no model: `astrabox-hermes-config-merge`
# turns the platform's config blobs into the profile's config.yaml, and without
# the blobs in its environment it writes nothing.
#
# Every program runs as that account. The bridge must: the gateway's control
# socket answers only a peer of the gateway's own uid.
exec runuser -u "$ASTRABOX_HERMES_PROFILE_LINUX_USER" -- env \
  HOME="$ASTRABOX_HERMES_PROFILE_HOME" \
  USER="$ASTRABOX_HERMES_PROFILE_LINUX_USER" \
  LOGNAME="$ASTRABOX_HERMES_PROFILE_LINUX_USER" \
  bash --noprofile --norc -c "
    set -euo pipefail
    source $(printf '%q' "$profile_env")
    export HOME=$(printf '%q' "$ASTRABOX_HERMES_PROFILE_HOME")
    export USER=$(printf '%q' "$ASTRABOX_HERMES_PROFILE_LINUX_USER")
    export LOGNAME=$(printf '%q' "$ASTRABOX_HERMES_PROFILE_LINUX_USER")
    export TERMINAL_CWD=$(printf '%q' "$ASTRABOX_HERMES_WORKSPACE")
    cd $(printf '%q' "$ASTRABOX_HERMES_WORKSPACE")
    case $(printf '%q' "$mode") in
      mirror)
        exec \"\$HERMES_VENV/bin/python\" /opt/astrabox/hermes/hermes_state_mirror.py \
          mirror --profile-env $(printf '%q' "$profile_env")
        ;;
      bridge)
        exec \"\$HERMES_VENV/bin/python\" /opt/astrabox/hermes/hermes_gateway_bridge.py \
          $(printf '%q' "$LISTEN_PORT") $(printf '%q' "$DAEMON_WAIT_SECONDS")
        ;;
    esac
    # One interpreter restores and prepares the profile, then enters the native
    # CLI with --no-supervise --external-supervisor under supervisord. It removes
    # the bridge credential before the gateway or its tools can inherit it.
    exec \"\$HERMES_VENV/bin/python\" /opt/astrabox/hermes/hermes_gateway_prepare.py \
      --profile-env $(printf '%q' "$profile_env") \
      >> $(printf '%q' "$log_dir/astrabox-hermes-serve.log") 2>&1
  "
