 # or child-process export: a bound id alone cannot authorize detached delivery.
 _SESSION_HISTORY_DELIVERY = ContextVar("HERMES_SESSION_HISTORY_DELIVERY", default=_UNSET)

+# Tool children inherit this task-local mapping, never the resident process.
+_SESSION_TOOL_ENVIRONMENT = ContextVar("HERMES_SESSION_TOOL_ENVIRONMENT", default=None)
+
+
+def validate_tool_environment(value: dict[str, str]) -> dict[str, str]:
+    """Validate caller context without allowing native credentials or identity overrides."""
+    import re
+    from tools.environments.local_env_policy import _is_hermes_internal_secret, _is_provider_env_blocklisted
+    if not isinstance(value, dict):
+        raise ValueError("tool environment must be a string mapping")
+    for key, item in value.items():
+        if (not isinstance(key, str) or not isinstance(item, str)
+                or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) or "\0" in item
+                or key.upper().startswith(("HERMES_", "_HERMES_"))
+                or key.upper() in {"HOME", "USER", "LOGNAME", "PATH", "PYTHONPATH", "PYTHONHOME", "VIRTUAL_ENV", "CONDA_PREFIX"}
+                or _is_hermes_internal_secret(key) or _is_provider_env_blocklisted(key)):
+            raise ValueError("tool environment conflicts with the native runtime")
+    return dict(value)
+
+
+def get_tool_environment() -> dict[str, str]:
+    """Current Session's tool context; callers cannot mutate the bound mapping."""
+    return dict(_SESSION_TOOL_ENVIRONMENT.get() or {})
+
