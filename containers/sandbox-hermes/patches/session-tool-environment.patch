+def bind_session_tool_environment(authority, session_id, value, *, running):
+    """Hold *value* as *session_id*'s tool environment for its next turns (``session.create`` and
+    ``session.resume``). Like a launch key it lives in this authority's memory only: an owner restart
+    drops it and the next resume supplies it again. A running turn keeps the mapping it started with,
+    so a different one is refused while *running*."""
+    from gateway.session_context import validate_tool_environment
+    try:
+        value = validate_tool_environment(value)
+    except ValueError as exc:
+        _refuse('tool_environment', str(exc))
+    held = authority.__dict__.setdefault('_session_tool_environments', {})
+    if running and held.get(session_id, value) != value:
+        raise RuntimeStoreError('session_busy')
+    held[session_id] = value
+
+
+def _held_tool_environment(authority, source, policy):
+    """``(required, mapping)``: whether the session's creation carried a tool environment, and the
+    mapping this authority holds for it (``None`` until a viewer supplies one after a restart)."""
+    if policy is None or json.loads(policy.request_json).get('tool_environment') is not True:
+        return False, None
+    held = getattr(authority, '_session_tool_environments', None) or {}
+    return True, held.get(source.chat_id)
+
+
+def require_session_tool_environment(authority, source):
+    """Claim preflight: a session created with a tool environment runs no turn without it. After an
+    owner restart its admissions stay queued (the FIFO pauses) until a viewer's ``session.resume``
+    supplies the mapping again and wakes the drain."""
+    required, value = _held_tool_environment(authority, source, policy_for_source(authority.runner, source))
+    if required and value is None:
+        raise RuntimeStoreError('tool_environment_unavailable')
+
+
+@contextmanager
+def session_tool_environment(authority, source, policy):
+    """Bind the tool environment a session was created with for one of its turns."""
+    required, value = _held_tool_environment(authority, source, policy)
+    if not required:
+        yield
+        return
+    if value is None:
+        raise RuntimeStoreError('tool_environment_unavailable')
+    from gateway.session_context import tool_environment_scope
+    with tool_environment_scope(value):
+        yield
+
