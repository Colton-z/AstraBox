--- a/bundle/chunk-AJWRYQPH.js
+++ b/bundle/chunk-AJWRYQPH.js
@@ -2087,6 +2087,8 @@
     try {
       writePrivateAtomicJson(initialStatusPath, {
         ...initialStatus,
+        ...cfg.parentWorkflowRunId ? { parentWorkflowRunId: cfg.parentWorkflowRunId } : {},
+        ...cfg.workflowKey ? { workflowKey: cfg.workflowKey } : {},
         ...launcher ? {} : { pid: proc.pid, pidNamespaceScope: currentPidNamespaceScope(), ...bootId ? { bootId } : {} },
         processTerminal: { version: 1, state: "pending", runId: initialStatus.runId, runnerProcessInstanceId }
       });
--- a/src/runs/background/async-execution.js
+++ b/src/runs/background/async-execution.js
@@ -652,6 +652,8 @@
         try {
             writePrivateAtomicJson(initialStatusPath, {
                 ...initialStatus,
+                ...(cfg.parentWorkflowRunId ? { parentWorkflowRunId: cfg.parentWorkflowRunId } : {}),
+                ...(cfg.workflowKey ? { workflowKey: cfg.workflowKey } : {}),
                 ...(launcher ? {} : { pid: proc.pid, pidNamespaceScope: currentPidNamespaceScope(), ...(bootId ? { bootId } : {}) }),
                 processTerminal: { version: 1, state: "pending", runId: initialStatus.runId, runnerProcessInstanceId },
             });
