# syntax=docker/dockerfile:1
#
# AstraBox — in-sandbox Codex image (one app-server per box).
#
# The container the sandbox backend spawns for a `codex` session: the
# counterpart of the claude-code, hermes and deepseek-harness images. It
# installs OpenAI's CLI (`@openai/codex`, Apache-2.0) from npm the way the
# vendor installs it, and registers `codex app-server` as a supervised service
# of the base image. AstraBox composes nothing: what Codex IS — its tools, its
# prompt, its sandbox enforcement — is the vendor's product decision.
#
# Nothing about a deployment is baked in here. Codex takes a whole
# `model_providers` table as a per-thread config override, so the model
# gateway's address travels with `thread/start`; the only value this image
# reads from its environment is the API key, because that is what a provider's
# `env_key` names.
#
# Build (repo-root context):
#   docker build -t astrabox/sandbox-codex:latest \
#     -f containers/sandbox-codex/Dockerfile .
#
# Base image: the same PUBLIC AIO Sandbox base as the other engine images. It
# ships the Node.js runtime the CLI needs, and its entrypoint creates one
# workload account per container start from `$USER`/`$USER_UID`/`$USER_GID` —
# which the ENV block below names, so the account is the `agent` the adapter's
# runtime profile declares. OpenSandbox's native execd and Filesystem APIs
# provide command and file transport.
# Both ARGs precede the first FROM: an ARG between FROMs is scoped to the
# stage above it, and the second FROM would then see its base name blank.
ARG SANDBOX_EXECD_IMAGE=opensandbox/execd:v1.1.0
ARG SANDBOX_BASE_IMAGE=ghcr.io/agent-infra/sandbox:1.11.0
FROM ${SANDBOX_EXECD_IMAGE} AS execd
FROM ${SANDBOX_BASE_IMAGE}

# Pinned CLI version — the build-time contract with the vendor. This is the
# vendor's own `latest` npm tag, and the app-server protocol schema this
# adapter was written against is the one generated by the matching source tag
# (`rust-v0.153.4`); the two move together and should be bumped together.
ARG CODEX_VERSION=0.153.4
ARG CODEX_PREFIX=/opt/codex

USER root

# OpenSandbox injects execd and bootstrap through every standard lifecycle
# create, including creates issued by the official SDK client-pool creator.
# The pinned image copies below are not the prewarming mechanism. Bubblewrap and
# the image-owned isolation policy remain required for shared tenancy: Codex
# enforces its sandbox with a nested bwrap, and execd's default seccomp denylist
# kills that wrapper at boot. The policy file says which syscalls are handed
# back and why; its writable roots must stay identical to the shared file's.
COPY --from=execd /execd /execd
COPY --from=execd /bootstrap.sh /bootstrap.sh
COPY containers/sandbox-codex/execd-isolation.toml \
     /opt/astrabox/opensandbox/isolation.toml
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends bubblewrap; \
    rm -rf /var/lib/apt/lists/*; \
    bwrap --version; \
    mkdir -p /opt/astrabox/opensandbox; \
    ln /execd /opt/astrabox/opensandbox/execd; \
    ln /bootstrap.sh /opt/astrabox/opensandbox/bootstrap.sh; \
    chmod 0555 /execd /bootstrap.sh; \
    chmod 0444 /opt/astrabox/opensandbox/isolation.toml; \
    /opt/astrabox/opensandbox/execd --help 2>&1 | grep -q 'OpenSandbox Execd'

# Installed under a prefix AstraBox owns rather than the base image's global
# node prefix: the CLI must not be able to shadow a base-image tool the
# sandbox's own services resolve from PATH.
#
# The consequence is that the box holds two Codex installations, and `codex` on
# PATH is the base image's, not this one. The app-server runs from the absolute
# path in `astrabox-codex-serve`, so the product is unaffected — but anything
# typed into the box resolves the other version, including
# `codex app-server generate-json-schema`, which is where the protocol this
# adapter is written against comes from. Generate it from
# ${CODEX_PREFIX}/node_modules/.bin/codex or the schema describes a version
# nothing here runs.
RUN set -eux; \
    mkdir -p "${CODEX_PREFIX}"; \
    npm install --prefix "${CODEX_PREFIX}" --no-audit --no-fund \
      "@openai/codex@${CODEX_VERSION}"; \
    npm cache clean --force

# The binary must exist and report the version this image pinned. `codex` is
# an npm shim over a platform-specific vendored binary, so a package that
# installed cleanly can still be missing the architecture this image runs on —
# a failure that would otherwise surface as a box that boots and never
# answers.
RUN set -eux; \
    installed="$("${CODEX_PREFIX}/node_modules/.bin/codex" --version)"; \
    printf 'codex --version: %s\n' "${installed}"; \
    case "${installed}" in \
      *"${CODEX_VERSION}"*) ;; \
      *) echo "codex reports '${installed}', not ${CODEX_VERSION}" >&2; exit 1 ;; \
    esac

COPY containers/sandbox-codex/astrabox-codex-serve ${CODEX_PREFIX}/serve.sh
COPY containers/sandbox-codex/astrabox-codex-forward ${CODEX_PREFIX}/forward.py
COPY astrabox/core/service/orchestrator/runtime/astrabox-transcript-mirror \
     ${CODEX_PREFIX}/mirror.py
# Which files this image's engine keeps its conversations in. The mirror holds
# no engine knowledge; naming them is how an image says what it writes.
ENV ASTRABOX_TRANSCRIPT_MIRROR_ROOT=/home/agent/.codex/sessions \
    ASTRABOX_TRANSCRIPT_MIRROR_GLOB=*.jsonl \
    ASTRABOX_TRANSCRIPT_MIRROR_NAMESPACE=codex/
# One catalog writer for both service shapes (the box-level server and a
# conversation's own instance under the Agent-shared tenancy); the shared-box
# stack is triggered by the platform inside a conversation's isolated session
# rather than supervised at boot — a session's processes die with it.
COPY containers/sandbox-codex/astrabox-model-catalog.py \
     ${CODEX_PREFIX}/model-catalog.py
COPY containers/sandbox-codex/astrabox-codex-serve-conversation \
     ${CODEX_PREFIX}/serve-conversation.sh
COPY containers/sandbox-codex/supervisord.codex.conf \
     /opt/gem/supervisord/supervisord.codex.conf
RUN set -eux; \
    chmod 0755 "${CODEX_PREFIX}/serve.sh" "${CODEX_PREFIX}/forward.py" \
      "${CODEX_PREFIX}/model-catalog.py" "${CODEX_PREFIX}/serve-conversation.sh"; \
    bash -n "${CODEX_PREFIX}/serve.sh"; \
    bash -n "${CODEX_PREFIX}/serve-conversation.sh"; \
    python3 -m py_compile "${CODEX_PREFIX}/forward.py"; \
    python3 -m py_compile "${CODEX_PREFIX}/model-catalog.py"

# The base's workload-account contract, asserted at BUILD time.
#
# This base ships NO account: its entrypoint creates one on every container
# start from `$USER`/`$USER_UID`/`$USER_GID`. Naming that account is the ONLY
# way to get one workload identity, and it is not optional here — the adapter's
# runtime profile declares `SANDBOX_IMAGE_WORKLOAD_USER`, and the platform
# renders that name into every spawn AND into the owner it asks execd to chown
# uploaded files to. An image that leaves the base's default in place looks
# entirely healthy (the CLI runs fine as whoever it is) until a file upload
# fails 500 on an account the box does not have.
#
# Creating a second account here instead would collide: the entrypoint's
# `groupadd --gid 1000` hits a gid this build already took, `set -e` kills it,
# and the container exits 4 before ANY service starts. These checks fail the
# build instead, if a base ever stops honouring the knobs or starts shipping an
# account at the selected uid. Pre-owning the workspace numerically closes the
# race in which a resident service answers before the entrypoint's chown.
RUN set -eux; \
    grep -q 'useradd --uid \$USER_UID' /opt/gem/gem.sh; \
    command -v getent; \
    command -v runuser; \
    ! getent passwd 1000; \
    ! getent group 1000; \
    install -d -o 1000 -g 1000 -m 0755 /workspace

# USER / USER_UID / USER_GID / WORKSPACE are the base image's knobs. Every value
# is a constant of the IMAGE, which is what makes prewarming work: a prepared box
# created before any session exists has run the entrypoint too, so its account
# is identical to a cold-created box's. `astrabox-codex-serve` reads `$USER` and
# `$WORKSPACE` from here; the host names the same account through
# runtime_profiles.SANDBOX_IMAGE_WORKLOAD_USER, _WORKLOAD_HOME and
# _WORKSPACE_DIR. tests/sandbox_workload_identity_test.py checks that they agree.
# The conversation-assembly script the platform's shared-tenancy bootstrap
# runs in every box (account, home, workspace, caches for one conversation).
# The claude and hermes images always carried it; a shared placement on this
# image died with `astrabox-provision-conversation: No such file or
# directory` until it did too.
COPY astrabox/core/service/orchestrator/runtime/provision-conversation \
     /usr/local/bin/astrabox-provision-conversation
RUN chmod 0555 /usr/local/bin/astrabox-provision-conversation && \
    bash -n /usr/local/bin/astrabox-provision-conversation

# Without this execd loads its default isolation policy, whose writable
# allowlist does not include /home/conversations — every shared placement
# then dies as `create isolated session failed. Status: 400`.
ENV EXECD_ISOLATION_CONFIG=/opt/astrabox/opensandbox/isolation.toml
ENV ASTRABOX_WORKLOAD_USER=agent \
    USER=agent \
    USER_UID=1000 \
    USER_GID=1000 \
    WORKSPACE=/workspace

WORKDIR /workspace
