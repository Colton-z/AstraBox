+// AstraBox modification: retain native refusal codes through upgraded proxies.
+func ptyRefuseWebSocket(ctx *gin.Context, status int, code model.ErrorCode, wsCode, message string) {
+	if ctx.Query("errors") != "frame" {
+		ctx.JSON(status, model.ErrorResponse{Code: code, Message: message})
+		return
+	}
+	conn, err := wsUpgrader.Upgrade(ctx.Writer, ctx.Request, nil)
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+	writeErrFrame(conn, wsCode, message)
+	_ = conn.WriteControl(websocket.CloseMessage,
+		websocket.FormatCloseMessage(websocket.ClosePolicyViolation, wsCode),
+		time.Now().Add(wsWriteDeadline))
+}
