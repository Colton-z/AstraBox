# GENERATED FILE: do not edit. Generated from astrabox/config/env_registry.py
# by scripts/gen_config_docs.py.
#
# Every setting an operator of the Compose deployment can put in
# containers/.env, with its default. To change one, copy its line into
# containers/.env without the leading "#", set the value, and run
# `docker compose up -d` in this directory (or run the installer again).
# A setting left out keeps the default shown here.
#
# scripts/install.sh reads the first section: a "#?" line says why the
# setting below it deserves a look before the deployment takes work.

# >>> review at first install

#? Sandboxes may take all of this host's memory but 4 GiB. Set a ceiling when the host runs anything else.
# Most memory, summed over box limits and the egress sidecar each Docker box
# runs beside it, that one backend's sandboxes may hold (a Kubernetes quantity
# such as 12Gi). Empty: on the bundled Docker server, the Docker host's memory
# less 4Gi; elsewhere no ceiling. unlimited sets none. Startup logs the value
# in force and where it came from, and warns when it is derived from the host:
# the host's memory says nothing about other software running on it.
#ASTRABOX_SANDBOX_QUOTA_MEMORY=

#? Sandboxes may take every CPU of this host. Set a ceiling when the host runs anything else.
# Most CPU, summed over box limits and their sidecars, that one backend's
# sandboxes may hold (a Kubernetes quantity). Empty or unlimited sets no
# ceiling.
#ASTRABOX_SANDBOX_QUOTA_CPU=

#? No limit on how many sandboxes run at once.
# Most sandboxes one sandbox backend runs for this deployment, counting boxes
# being created, prepared in pools and awaiting confirmed destruction. A
# create past it is refused with SANDBOX_CAPACITY_EXHAUSTED. Empty or
# unlimited sets no ceiling. Startup refuses a ceiling on a backend that
# cannot list its sandboxes.
#ASTRABOX_SANDBOX_QUOTA_BOXES=

#? CPU of each conversation's sandbox. Builds and test suites need more.
# CPU limit of a conversation's own box (RuntimeProfile
# sandbox_tenancy=conversation), as a Kubernetes quantity (2, 0.5, 500m), for
# every such box: created on demand, prepared in a pool, or replacing a lost
# one. A backend that cannot honour it refuses the create with
# SANDBOX_RESOURCES_UNSUPPORTED before anything is allocated; the bundled
# OpenSandbox server on Docker lowers a CPU limit above the host's CPU count
# to that count. A RuntimeProfile's sandbox_cpu replaces it for that profile's
# boxes, and caps their CPU request.
#ASTRABOX_SANDBOX_CPU_LIMIT=1

#? Memory of each conversation's sandbox. Builds and test suites need more.
# Memory limit of a conversation's own box, as a Kubernetes quantity (1Gi,
# 768Mi). Startup refuses a value that is not a quantity. A RuntimeProfile's
# sandbox_memory replaces it, and the memory request, for that profile's
# boxes.
#ASTRABOX_SANDBOX_MEMORY_LIMIT=1Gi

#? A conversation's sandbox, with the files in it, is removed this long after its last work.
# The conversation sandbox lease; renewed while the runtime reports work
# (working, waiting or background), however long one response runs. An
# abandoned session dies roughly one lease after its last activity.
#ASTRABOX_SANDBOX_LEASE_SECONDS=14400

#? What new RuntimeProfiles do with an idle sandbox: terminate removes it when its lease ends, pause keeps it parked.
# Seeds a RuntimeProfile's own idle_action when one is created without stating
# it. Every RuntimeProfile then carries its own value, and that is what a
# lapsed lease acts on; this setting is not consulted again. 'terminate'
# destroys the sandbox and its workspace, 'pause' commits the filesystem and
# frees the compute so the next turn resumes the same sandbox with its files.
# 'pause' is refused at startup unless the sandbox backend declares it can
# snapshot.
#ASTRABOX_SANDBOX_IDLE_ACTION=terminate

#? Every signed-in user may create Agents and Assistants.
# When true, only holders of the administrator role create Agents and
# Assistants; everyone else gets 403 FORBIDDEN and can still use the Agents an
# administrator makes available. For a deployment whose users should only use
# published Agents, such as an open or public one. What any author's fields
# may reach is bounded either way.
#ASTRABOX_AUTHORING_ADMIN_ONLY=false

#? Every account the identity provider signs in may use this deployment; members admits only the Environment's member list.
# Environment entry policy from astrabox.environment.entry. The default,
# authenticated, admits every identity the deployment's sign-in verifies.
# members admits only the Environment's member list, for an identity provider
# shared with other deployments; a deployment may also select an installed
# policy for verified enterprise identities. Does not grant resource
# permissions or roles. Unknown policies refuse startup; policy failures
# refuse entry.
#ASTRABOX_ENVIRONMENT_ENTRY_POLICY=authenticated

# <<< review at first install

# Every other setting, by name.

# API key for the Anthropic-compatible model endpoint. Requests use the x-api-
# key header when neither bearer-token alias is configured.
#ANTHROPIC_API_KEY=

# Bearer token for the Anthropic-compatible model endpoint. It shares a
# setting with ANTHROPIC_API_KEY and ASTRABOX_LLM_AUTH_TOKEN; the first
# configured value in that order takes precedence.
#ANTHROPIC_AUTH_TOKEN=

# Base URL of the Anthropic-compatible LLM endpoint the agent loop calls; the
# one required setting for a bring-your-own-key install. Aliased with
# ASTRABOX_LLM_BASE_URL (same field, either name works).
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model id passed to the agent loop. Aliased with ASTRABOX_LLM_MODEL
# (same field, either name works).
#ANTHROPIC_MODEL=claude-opus-4-8

# Optional bearer token locking the /api/v1/admin-api automation surface;
# unset keeps it open (single-tenant default).
#ASTRABOX_ADMIN_API_TOKEN=

# Group name mapped to the 'admin' role; shared by both SSO resolvers
# (trusted-header and JWT).
#ASTRABOX_ADMIN_GROUP=astrabox-admin

# Enables the Agent APIs and Session creation.
#ASTRABOX_AGENT_ENABLED=true

# Agent sandbox container image, used by every Claude Code RuntimeProfile that
# pins none of its own. Unset, it is <ASTRABOX_IMAGE_PREFIX>sandbox-claude-
# code:<ASTRABOX_IMAGE_TAG>. The image must include @anthropic-ai/claude-code.
# Also read by `astrabox up`, which reports whether the image is present on
# the host rather than letting the first session fail to find it.
#ASTRABOX_AGENT_IMAGE=

# Use prepared Agent capacity in this Environment. False selects cold
# admission and disables pool creation, refill and acquisition without
# changing the Agent's configured prepared_capacity. Retirement and cleanup
# apply only to this Environment's inventory.
#ASTRABOX_AGENT_PREWARM_ENABLED=true

# Comma-separated Host allowlist for the DNS-rebinding guard; REPLACES the
# default list wholesale. Exposing the console behind a real hostname means
# adding it here (and putting real authentication in front).
#ASTRABOX_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# When persistent workspace storage is enabled, also mount the Assistant's
# live engine profile on that volume. False mounts only workspace files and
# keeps the profile on the sandbox filesystem; native and profile snapshots
# still use the platform database and the same save barriers. A mounted
# profile requires the vendor's SQLite filesystem semantics.
#ASTRABOX_ASSISTANT_PROFILE_ON_WORKSPACE_VOLUME=true

# CPU limit of an Assistant's workspace box, as a Kubernetes quantity, for
# every such box. The box stays running between messages so the Assistant can
# answer its channels and run its scheduled jobs. A RuntimeProfile's
# sandbox_cpu replaces it for that profile's boxes, and caps their CPU
# request.
#ASTRABOX_ASSISTANT_SANDBOX_CPU_LIMIT=1

# CPU request of an Assistant's workspace box. An idle Assistant uses about
# 50m. Startup refuses one above ASTRABOX_ASSISTANT_SANDBOX_CPU_LIMIT.
#ASTRABOX_ASSISTANT_SANDBOX_CPU_REQUEST=100m

# Memory limit of an Assistant's workspace box, as a Kubernetes quantity.
# Hermes and its desktop use about 860Mi when idle. A RuntimeProfile's
# sandbox_memory replaces it, and the memory request, for that profile's
# boxes.
#ASTRABOX_ASSISTANT_SANDBOX_MEMORY_LIMIT=1Gi

# Memory request of an Assistant's workspace box. Startup refuses one above
# ASTRABOX_ASSISTANT_SANDBOX_MEMORY_LIMIT.
#ASTRABOX_ASSISTANT_SANDBOX_MEMORY_REQUEST=1Gi

# HS256 signing secret for the console session cookie. Empty = a key is
# generated once into <state_dir>/auth-session.key (mode 0600). Multi-replica
# deployments must set the same value in every replica.
#ASTRABOX_AUTH_SESSION_SECRET=

# Console session cookie lifetime in seconds (default 7 days).
#ASTRABOX_AUTH_SESSION_TTL_SECONDS=604800

# Immutable symmetric AWS KMS key ARN used when ASTRABOX_SECRET_STORE=aws_kms.
# The workload identity needs kms:GenerateDataKey and kms:Decrypt; the value
# is rejected for every non-key ARN shape.
#ASTRABOX_AWS_KMS_KEY_ARN=

# Run channel and scheduler workers in this Environment. False retains
# interactive work and Environment-owned runtime ingestion, recovery, cleanup
# and active sandbox keepalive; Agent prewarming is controlled separately.
#ASTRABOX_BACKGROUND_EXECUTION_ENABLED=true

# Browser-facing Casdoor management URL shown to platform administrators. The
# bundled SSO Compose overlay sets it to the public issuer. Leave it empty for
# another OIDC provider or when Casdoor management is not reachable from the
# browser.
#ASTRABOX_CASDOOR_ADMIN_URL=

# Browser-facing Casdoor application URL shown as the API-access management
# entry. It is exposed only when OIDC API credentials are configured; the
# bundled SSO overlay fills it automatically.
#ASTRABOX_CASDOOR_API_ACCESS_URL=

# Casdoor organization whose accounts may use AstraBox when the OIDC provider
# is Casdoor; the bundled SSO overlay sets the one its seed creates, astrabox.
# AstraBox then refuses an ID token or access token whose Casdoor `owner`
# claim names another organization, such as `built-in`, whose administrators
# Casdoor lets sign in to every application, and a client-credentials token
# from any client but ASTRABOX_OIDC_API_CLIENT_ID. Access tokens must be
# Casdoor JWTs. Empty checks no organization, for a provider other than
# Casdoor.
#ASTRABOX_CASDOOR_ORGANIZATION=

# Which AstraBox account a messaging participant runs as when a trigger runs
# as linked accounts. links reads the links administrators keep on each
# trigger; an installed resolver can answer from a directory instead. Unknown
# names fail during startup.
#ASTRABOX_CHANNEL_ACCOUNT_RESOLVER=links

# Lease lifetime in seconds for processing an inbound messaging-platform
# event. Active processing renews the lease; an event becomes eligible for
# retry after this interval without renewal. The minimum is 300 seconds.
#ASTRABOX_CHANNEL_CLAIM_STALE_SECONDS=900

# Private channel-adapter gateway URL. Empty makes the server image run its
# bundled gateway on loopback. Multi-replica deployments set one shared HTTPS
# URL; plaintext HTTP is accepted only on loopback.
#ASTRABOX_CHANNEL_GATEWAY_BASE_URL=

# Service-to-service credential shared by AstraBox and the private channel
# gateway. The bundled deployment generates an ephemeral value. An external
# gateway uses the same operator-supplied value on both services; the value
# must contain at least 32 characters.
#ASTRABOX_CHANNEL_GATEWAY_TOKEN=

# Interval in seconds for projecting Session output and retrying expired
# inbound events and unfinished outbound deliveries. Multiple replicas can run
# this recovery loop. The minimum is 1 second.
#ASTRABOX_CHANNEL_RECONCILE_INTERVAL_SECONDS=5

# The connector hub's PLATFORM_ADMIN_EMAIL. AstraBox administers the hub as
# this user, and an administrator's verifying consent for a connector is
# stored under it.
#ASTRABOX_CONTEXTFORGE_ADMIN_EMAIL=

# Where the AstraBox server reaches the connector hub's API (ContextForge),
# for example http://contextforge:4444. Unset with the other
# ASTRABOX_CONTEXTFORGE_* variables, the deployment runs no hub and offers no
# connectors; setting only some of them is refused on first use.
#ASTRABOX_CONTEXTFORGE_API_URL=

# The connector hub's JWT_SECRET_KEY. AstraBox signs the session tokens that
# make the hub act as one of its users with it.
#ASTRABOX_CONTEXTFORGE_JWT_SECRET=

# The connector hub's browser-facing address: the console's origin followed by
# /connector-hub, for example https://astrabox.example.com/connector-hub. A
# vendor returns the browser to <this>/oauth/callback, which AstraBox hands to
# the hub and which each vendor OAuth app registers as its redirect URI; the
# hub then returns the browser to the console. Vendors accept only an https
# address, or http at localhost.
#ASTRABOX_CONTEXTFORGE_PUBLIC_URL=

# Native connection URL for ASTRABOX_PERSISTENCE_PROVIDER; postgres uses
# postgresql://. The maintained local launchers populate it from generated
# service-scoped credentials; direct and external deployments must set it
# explicitly. The server does not start with any URL unsupported by the
# selected provider.
#ASTRABOX_DB_URL=

# Comma-separated secret names that Agent and Assistant repositories and
# Skills may use as deploy_key_secret_name, for example your-repo-deploy-key.
# Each name resolves like every secret name (upper-cased, hyphens to
# underscores). Any other name is refused with AGENT_DEPLOY_KEY_NOT_ALLOWED,
# so an author cannot read an arbitrary server environment variable. Empty
# allows none.
#ASTRABOX_DEPLOY_KEY_SECRET_NAMES=

# Token of the GitHub agent account every dsh-superagent Assistant acts as
# unless its owner sets one of their own: a classic token with repo and
# notifications. Read through SecretProvider as the secret astrabox-dsh-
# superagent-github-token, the dsh_superagent engine's deployment_secret for
# its github_token.
#ASTRABOX_DSH_SUPERAGENT_GITHUB_TOKEN=

# Existing AWS EFS filesystem ID (fs-...), required when
# ASTRABOX_STORAGE_PROVIDER=aws_efs. The provider requires Kubernetes, shared
# workspace topology, and a Bound ReadWriteMany PVC configured by
# ASTRABOX_SANDBOX_WORKSPACE_VOLUME. Its PV must use efs.csi.aws.com, exactly
# this filesystem ID as volumeHandle, and encryption in transit. EFS
# resources, CSI installation and credentials remain deployment-owned.
#ASTRABOX_EFS_FILE_SYSTEM_ID=

# Master feature flag (is_astrabox_enabled()); false disables the feature
# wholesale.
#ASTRABOX_ENABLED=true

# Deployment environment label (diagnostic) and the app-{env}.yml YAML-overlay
# selector. Aliased with SERVER_ENV.
#ASTRABOX_ENV=community

# Immutable Environment owning this process's Agent/Assistant definitions,
# profiles, credentials, authorization, history, native state and runtime
# resources. Replicas of one Environment use the same name; other Environments
# use different names, separate databases, database credentials, state
# directories and membership. A database accepts one persisted Environment
# name. Requires 3–30 lowercase letters, digits, underscores or hyphens,
# starting with a letter or digit.
#ASTRABOX_ENVIRONMENT_NAME=astrabox

# Selects the ExtensionProvider whose MCP server and Skill catalog Agents and
# Assistants select from, and which supplies runtime bindings and provider-
# owned MCP request authorization. Empty selects the provider that declares
# itself as the deployment default (litellm). 'none' runs no catalog: Agents
# and Assistants use only the MCP servers, Skills and packages written on
# them, and a record that still holds a catalog selection is named at startup
# and fails new work with EXTENSION_CATALOG_DISABLED until that selection is
# removed. Startup refuses a name no installed provider registers.
#ASTRABOX_EXTENSION_PROVIDER=

# The one Git host ASTRABOX_GIT_HTTPS_TOKEN_SECRET_NAME authenticates to, for
# example github.com. Required with that setting and refused without it; a
# clone of any other host does not receive the token.
#ASTRABOX_GIT_HTTPS_TOKEN_HOST=

# Name of the secret holding a Git host HTTPS access token. It is used only
# where a sandbox backend cannot reach Git over SSH and an SSH repository is
# cloned over HTTPS instead, and only for the host in
# ASTRABOX_GIT_HTTPS_TOKEN_HOST. Startup refuses it on a backend that clones
# over SSH. A repository declared as HTTPS never receives it; private HTTPS
# sources use an http_basic Vault credential.
#ASTRABOX_GIT_HTTPS_TOKEN_SECRET_NAME=

# Where the connector hub reaches this deployment's google_workspace_mcp
# instance for Gmail (TOOLS=gmail, external OAuth mode), for example
# http://gmail-mcp:8000/mcp. Unset leaves the Gmail connector unavailable.
#ASTRABOX_GMAIL_MCP_URL=

# Where the connector hub reaches this deployment's google_workspace_mcp
# instance for Google Calendar (TOOLS=calendar). Unset leaves the connector
# unavailable.
#ASTRABOX_GOOGLE_CALENDAR_MCP_URL=

# Where the connector hub reaches this deployment's google_workspace_mcp
# instance for Google Drive (TOOLS=drive). Unset leaves the connector
# unavailable.
#ASTRABOX_GOOGLE_DRIVE_MCP_URL=

# Repository prefix of every default AstraBox image; the component name
# (server, sandbox-claude-code, sandbox-hermes, workspace-mounter, ...) is
# appended. Set it to a registry mirror that holds the published images.
# scripts/compose.sh sets astrabox/, the prefix `make build-*` gives images
# built from a checkout. The Compose file applies it to the server image too.
#ASTRABOX_IMAGE_PREFIX=ghcr.io/colton-z/astrabox-

# Tag of every default AstraBox image. Unset, it is the installed AstraBox
# version, so a release runs the sandbox images published with it.
# scripts/install.sh writes the installed release; scripts/compose.sh sets
# latest for images built from a checkout. The Compose file applies it to the
# server image too.
#ASTRABOX_IMAGE_TAG=

# Comma-separated signature algorithms accepted; overrides the key-material
# path's default (RS256,ES256 for JWKS/OIDC, HS256 for the shared-secret
# path).
#ASTRABOX_JWT_ALGORITHMS=RS256,ES256

# Expected `aud` claim; when set, audience verification is enforced.
#ASTRABOX_JWT_AUDIENCE=

# JWT claim mapped to the user's email.
#ASTRABOX_JWT_EMAIL_CLAIM=email

# JWT claim mapped to group membership.
#ASTRABOX_JWT_GROUPS_CLAIM=groups

# OIDC issuer used for JWKS discovery when no JWKS URL is set; also checked as
# the expected `iss` claim whenever set, even alongside a JWKS URL.
#ASTRABOX_JWT_ISSUER=

# JWKS URL used to verify the token signature (RS256/ES256); takes precedence
# over ASTRABOX_JWT_ISSUER and ASTRABOX_JWT_SECRET.
#ASTRABOX_JWT_JWKS_URL=

# JWT claim mapped to the user's display name.
#ASTRABOX_JWT_NAME_CLAIM=name

# JWT claim mapped to the org id; unset falls back to the deployment default
# org.
#ASTRABOX_JWT_ORG_CLAIM=

# HS256 shared secret used to verify the token signature when neither a JWKS
# URL nor an issuer is set.
#ASTRABOX_JWT_SECRET=

# Strict (default): a missing bearer token is a 401. Set an explicit falsey
# value (0/false/no/off) to fall through anonymous instead.
#ASTRABOX_JWT_STRICT=true

# JWT claim mapped to the user id.
#ASTRABOX_JWT_USER_CLAIM=sub

# Browser-facing management URL for an external LiteLLM deployment. When
# empty, external gateways have no console link; the bundled gateway always
# uses AstraBox's protected /litellm route and rejects this setting.
#ASTRABOX_LITELLM_ADMIN_URL=

# API key the sandbox sends to the LiteLLM proxy.
#ASTRABOX_LITELLM_API_KEY=

# Base URL of an EXTERNAL LiteLLM proxy (your own gateway). Unset (the
# default) means the embedded proxy: sandboxes get the platform callback host
# on HTTP port 80 so Credential Vault can match it, the server talks to it
# over loopback, and the image starts it automatically.
#ASTRABOX_LITELLM_BASE_URL=

# Optional server-side URL for the same LiteLLM proxy. Set it only when the
# sandbox-facing URL uses private DNS or a different network path; the
# platform uses this address for its own gateway requests: model discovery,
# key management, titles and process summaries. Unset defaults to the external
# shared URL or embedded loopback.
#ASTRABOX_LITELLM_SERVER_BASE_URL=

# AstraBox-prefixed alias of ANTHROPIC_AUTH_TOKEN. Either name configures the
# same bearer-token setting.
#ASTRABOX_LLM_AUTH_TOKEN=

# AstraBox-namespaced alias of ANTHROPIC_BASE_URL — same field, either name
# works.
#ASTRABOX_LLM_BASE_URL=https://api.anthropic.com

# AstraBox-namespaced alias of ANTHROPIC_MODEL — same field, either name
# works.
#ASTRABOX_LLM_MODEL=claude-opus-4-8

# Enables local-development features: explicitly permitted plaintext model and
# sandbox keys, latest-version CLI installation, and per-Session debug paths.
# Standard bring-your-own-key deployments leave this false and use the regular
# credential settings.
#ASTRABOX_LOCAL_MODE=false

# Extra log directory the admin log viewer scans, in addition to ./logs.
#ASTRABOX_LOGGING_PATH=

# AstraBox application logger output format. Unset/`text` = the human-readable
# line format; `json` emits one structured JSON object per record
# (ts/level/logger/msg/module/line/exc) for a log aggregator. Root, Uvicorn,
# and third-party loggers retain their own format.
#ASTRABOX_LOG_FORMAT=

# uvicorn log level for the `astrabox serve` / programmatic entrypoints. Also
# read by astrabox.deploy.sandbox_server, which upper-cases it into the
# OpenSandbox lifecycle server's log level so one setting covers both
# processes in the container.
#ASTRABOX_LOG_LEVEL=info

# Base URL sandboxes use for platform-MCP and Session callback requests. A
# container deployment derives the server's bridge address when empty; a host
# deployment sets it explicitly, for example http://host.docker.internal:8000.
#ASTRABOX_MCP_PROXY_BASE_URL=

# Serve the /metrics Prometheus endpoint with basic in-process counters. Set
# false to return 404.
#ASTRABOX_METRICS_ENABLED=true

# Optional bearer token for /metrics. Unset (default): the endpoint is
# unauthenticated, the usual scrape posture for counter names + integers. Set
# it when /metrics is reachable beyond the scrape network: requests must then
# send Authorization: Bearer <token> (Prometheus authorization.credentials) or
# get 401.
#ASTRABOX_METRICS_TOKEN=

# Turn on the team pool of ChatGPT accounts. A conversation on a ChatGPT plan
# RuntimeProfile whose owner's account reported its plan usage limit spends,
# from its next response on, the owner's other accounts and then accounts
# other members of the organization shared with the team. False: a
# conversation spends only its owner's chosen account, and no account can be
# shared. YAML: astrabox.model_accounts.pool_enabled. Restart to apply.
#ASTRABOX_MODEL_ACCOUNT_POOL_ENABLED=false

# Operator override for the model credential used by Agent Sessions. It takes
# precedence over ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, and
# ASTRABOX_LLM_AUTH_TOKEN.
#ASTRABOX_MODEL_API_KEY=

# Name of the service-side secret entry that supplies the model API key. This
# keeps the credential out of plaintext deployment variables.
#ASTRABOX_MODEL_API_KEY_SECRET_NAME=

# Model endpoint requested from the selected model-endpoint plugin when no
# plugin-specific endpoint replaces it. Built-in LiteLLM uses
# ASTRABOX_LITELLM_BASE_URL for Agent inference.
#ASTRABOX_MODEL_BASE_URL=

# Selects the ModelEndpointProvider that decides the sandbox's wire endpoint.
# Empty selects the provider that declares itself as the deployment default.
#ASTRABOX_MODEL_ENDPOINT_PROVIDER=

# Read-only YAML policy for independent employee OIDC applications using the
# bundled model gateway. Separate from console/API login clients. Mount the
# policy and its server-only introspection secret files into the gateway
# container. Policy changes apply to the next request; invalid edits refuse
# OIDC inference. Rejected when the bundled gateway is disabled.
#ASTRABOX_MODEL_GATEWAY_OIDC_CONFIG_FILE=

# Require the sandbox-facing model gateway to use an HTTPS fully qualified
# domain name on port 443. The embedded gateway is intentionally HTTP-only for
# single-host development, so enabling this setting also requires an external
# ASTRABOX_LITELLM_BASE_URL. This transport rule is independent of whether
# Credential Vault is enabled.
#ASTRABOX_MODEL_GATEWAY_REQUIRE_HTTPS=false

# Overrides the deployment's default model (ANTHROPIC_MODEL): the model an
# Assistant that selects none runs, title requests use when
# ASTRABOX_TITLE_MODEL_NAME is empty, and a new installation seeds its Agents
# with. Every Agent runs the model it names.
#ASTRABOX_MODEL_NAME=

# Base path under the NAS mount used for Session workspaces. It prefixes the
# persistent workspace path on every storage backend.
#ASTRABOX_NAS_BASE_PATH=/astrabox

# Enables the NAS-backed shared workspace mount, and moves the agent's cwd to
# the mount target (/root/workspace). Only honored by a sandbox backend that
# mounts at runtime; the bundled open_sandbox backend mounts at create time,
# and setting this with it selected is refused at startup.
#ASTRABOX_NAS_ENABLED=false

# NAS endpoint address; required when ASTRABOX_NAS_ENABLED is set. Same
# backend condition as ASTRABOX_NAS_ENABLED.
#ASTRABOX_NAS_ENDPOINT=

# Group whose members get the admin role (same convention as the
# trusted_header/jwt resolvers).
#ASTRABOX_OIDC_ADMIN_GROUP=astrabox-admin

# OAuth client id for machine-to-machine AstraBox API access. When set with
# its secret, bearer tokens are checked through the provider's RFC 7662
# introspection endpoint and authorized by AstraBox API scopes.
#ASTRABOX_OIDC_API_CLIENT_ID=

# Long-lived OAuth machine-client secret used to issue and introspect short-
# lived AstraBox API tokens. This setting and
# ASTRABOX_OIDC_API_CLIENT_SECRET_FILE are mutually exclusive.
#ASTRABOX_OIDC_API_CLIENT_SECRET=

# File containing the long-lived OAuth machine-client secret. The bundled
# Casdoor deployment generates this file and mounts it only into Casdoor and
# AstraBox. This setting and ASTRABOX_OIDC_API_CLIENT_SECRET are mutually
# exclusive.
#ASTRABOX_OIDC_API_CLIENT_SECRET_FILE=

# OAuth client id registered at the IdP for the AstraBox console.
#ASTRABOX_OIDC_CLIENT_ID=

# OAuth client secret for the console token exchange. This setting and
# ASTRABOX_OIDC_CLIENT_SECRET_FILE are mutually exclusive.
#ASTRABOX_OIDC_CLIENT_SECRET=

# File containing the OAuth client secret for the token exchange. The bundled
# Casdoor deployment uses this form so the value is absent from the server
# container environment. This setting and ASTRABOX_OIDC_CLIENT_SECRET are
# mutually exclusive.
#ASTRABOX_OIDC_CLIENT_SECRET_FILE=

# ID-token claim read as the user's groups for role mapping.
#ASTRABOX_OIDC_GROUPS_CLAIM=groups

# Server-side base for discovery/token/JWKS calls when the IdP is reached
# differently from inside the deployment than from the browser (compose split-
# horizon: http://casdoor:8000). Empty = same as the issuer.
#ASTRABOX_OIDC_INTERNAL_ISSUER=

# OIDC issuer URL for the built-in login (ASTRABOX_WEB_IDENTITY=oidc): the
# browser-facing base the authorize redirect and id_token `iss` are validated
# against. Required (with the client id) when the oidc mode is selected.
#ASTRABOX_OIDC_ISSUER=

# Explicit OAuth redirect URL override for deployments behind a proxy whose
# external base the server cannot derive from the request. Empty = derived as
# <request base>/api/v1/auth/callback.
#ASTRABOX_OIDC_REDIRECT_URL=

# Scopes requested at authorization.
#ASTRABOX_OIDC_SCOPES=openid profile email

# Absent-session behaviour under the oidc resolver: strict (default) rejects
# with 401 AUTH_REQUIRED so the console redirects to login; an explicit falsey
# value leaves the request anonymous; protected API entry still requires an
# identity. A present-but-invalid session is always rejected regardless.
#ASTRABOX_OIDC_STRICT=true

# Relational persistence provider registered in
# astrabox.providers.persistence. The built-in postgres provider uses
# SQLAlchemy and asyncpg. Providers supply compatible SQLAlchemy engines,
# native conflict operations, schema and physical coordination guarantees;
# repository workflows stay shared in the platform. Selecting a provider alone
# does not establish dialect support.
#ASTRABOX_PERSISTENCE_PROVIDER=postgres

# Ceiling on the sum of every Agent's prepared_capacity. Creating or updating
# an Agent that would raise the sum above it is refused. Set it where idle
# sandboxes reserve nothing, such as a Docker host, so one Agent's capacity
# cannot exhaust the host. 0 means no ceiling.
#ASTRABOX_PREPARED_CAPACITY_LIMIT=0

# The path browsers and API clients reach AstraBox under, such as /astrabox,
# when a gateway publishes it below a path of a shared host: a reverse proxy
# that removes the path before forwarding, or an ASGI host that mounts the
# application there. Every URL AstraBox gives a browser or client carries it,
# including the console's page, sign-in callbacks, cookie paths and share
# links. A leading slash and no trailing slash; empty publishes AstraBox at
# the root of its host.
#ASTRABOX_PUBLIC_PATH_PREFIX=

# IP address used for Docker-published sandbox ports and for the bundled
# lifecycle server's connection back to those ports. Keep 127.0.0.1 when
# AstraBox runs on the host. When AstraBox runs in a container, use a
# reachable Docker host address, normally the bridge gateway; the maintained
# Compose stack sets 172.17.0.1 by default. A 0.0.0.0 address requires a
# firewall or authenticated proxy around sandbox HTTP and execd ports. The
# value must be an IP address. This setting applies to Docker only.
#ASTRABOX_PUBLISH_HOST_IP=127.0.0.1

# Name of the secret holding the OpenSandbox platform API key (resolved via
# SecretProvider).
#ASTRABOX_SANDBOX_API_KEY_SECRET_NAME=

# Comma-separated Docker networks of this host that a RuntimeProfile may join
# its sandboxes to, so they reach services there (sandbox_networks). Empty
# allows none. A joined network's subnet is reachable from the sandbox in both
# network-access modes; connections from it into the sandbox are refused.
# Bundled OpenSandbox server on the Docker runtime only, with Docker Engine
# 28.0 (API 1.48) or later. Checked when a RuntimeProfile is saved and each
# time a sandbox is created; the lifecycle server checks it again.
#ASTRABOX_SANDBOX_ATTACHABLE_NETWORKS=

# Name of the default sandbox backend: a RuntimeProfile that names no backend
# uses it, and the first Agent is seeded with it. Startup rejects a name that
# is not installed or not enabled.
#ASTRABOX_SANDBOX_BACKEND=open_sandbox

# Comma-separated names of the sandbox backends this deployment enables. Empty
# enables only ASTRABOX_SANDBOX_BACKEND. Installed backends outside this list
# are not offered to RuntimeProfiles, are not swept by background inventory or
# workspace-mount reconciliation, and records that name them fail with
# SANDBOX_BACKEND_DISABLED. Startup rejects a name that is not installed, a
# repeated name, and a list without ASTRABOX_SANDBOX_BACKEND.
#ASTRABOX_SANDBOX_BACKENDS=

# CPU request of a conversation's own box: the Kubernetes scheduler's
# reservation, not a ceiling. Startup refuses one above
# ASTRABOX_SANDBOX_CPU_LIMIT.
#ASTRABOX_SANDBOX_CPU_REQUEST=250m

# Keeps model, MCP, and assigned outbound credentials outside the sandbox and
# gives the Agent process placeholders. Enabled by default; the selected
# sandbox backend must implement protected credential delivery independently
# of RuntimeProfile networking. A false value passes the model credential to
# the Agent process and refuses managed outbound credentials, except
# environment credentials with header delivery, which need only a sandbox
# backend that declares it. A sandbox that received protected credentials
# while it was true is not reattached once it is false.
#ASTRABOX_SANDBOX_CREDENTIAL_VAULT=true

# OpenSandbox outbound proxy image used for provider network enforcement and
# protected credential injection. Unset, it is the release image
# <ASTRABOX_IMAGE_PREFIX>egress:<ASTRABOX_IMAGE_TAG>: OpenSandbox egress
# v1.1.7 with an addon that decrypts HTTPS only to hosts a protected
# credential is bound to, so every other connection, including those of
# containers an Agent runs in its sandbox, keeps the destination's own
# certificate. A missing image makes either requested OpenSandbox capability
# fail before allocation.
#ASTRABOX_SANDBOX_EGRESS_IMAGE=

# How the outbound proxy enforces network rules. Only 'dns+nft' is accepted:
# it filters names and enforces IP and CIDR rules with nftables. OpenSandbox's
# 'dns' mode filters names only, so the cloud-metadata deny, the Docker bridge
# deny and address entries in Limited allow lists would reach no packet; the
# server refuses to start with it.
#ASTRABOX_SANDBOX_EGRESS_MODE=dns+nft

# Scheme for OpenSandbox data-plane URLs: http or https. Leave unset when the
# lifecycle API and the ingress/execd endpoint use the same scheme. Set it
# when an internal HTTP lifecycle API returns routes served by an HTTPS
# ingress gateway.
#ASTRABOX_SANDBOX_ENDPOINT_SCHEME=

# Memory request of a conversation's own box: the Kubernetes scheduler's
# reservation, not a ceiling. Startup refuses one above
# ASTRABOX_SANDBOX_MEMORY_LIMIT.
#ASTRABOX_SANDBOX_MEMORY_REQUEST=1Gi

# Comma-separated absolute host directories that a RuntimeProfile may mount
# into its sandboxes (sandbox_mounts), each named exactly; a sub-directory is
# not allowed by its parent. Empty allows none. A read-write mount gives the
# sandbox write access to that host directory. Bundled OpenSandbox server on
# the Docker runtime only, which also renders it as its
# storage.allowed_host_paths.
#ASTRABOX_SANDBOX_MOUNTABLE_HOST_PATHS=

# Comma-separated Docker named volumes that a RuntimeProfile may mount into
# its sandboxes (sandbox_mounts). Empty allows none. Each must already exist
# when a sandbox is created; names use lowercase letters, digits and '-'.
# Bundled OpenSandbox server on the Docker runtime only.
#ASTRABOX_SANDBOX_MOUNTABLE_VOLUMES=

# PID limit for each Docker sandbox container. Kubernetes applies PID limits
# through the kubelet podPidsLimit setting instead.
#ASTRABOX_SANDBOX_PIDS_LIMIT=512

# Most sandboxes one backend creates at once. Empty or unlimited sets no
# ceiling.
#ASTRABOX_SANDBOX_QUOTA_CONCURRENT_CREATES=

# Protect browser-facing sandbox ports with OpenSandbox Secure Access. This
# requires the Kubernetes runtime, ingress.mode=gateway, and matching signing
# keys on the lifecycle server and the OpenSandbox ingress component. AstraBox
# opts cold-created and prewarmed sandboxes into protection and returns short-
# lived signed URLs. Docker does not support this setting and the bundled
# launcher refuses it there.
#ASTRABOX_SANDBOX_SECURE_ACCESS=false

# Deployment-wide sandbox runtime: gvisor, kata, firecracker, or empty for
# runc. The host or cluster must provide the selected runtime. Firecracker
# requires Kubernetes. OpenSandbox's outbound proxy, used by its networking
# and protected-delivery implementations, is incompatible with gVisor; use
# runc or Kata for that combination. Distinct runtime policies require
# separate AstraBox deployments.
#ASTRABOX_SANDBOX_SECURE_RUNTIME=

# Public host, host:port, or wildcard domain of the OpenSandbox ingress
# gateway. This value contains no URL scheme; configure the browser scheme
# with ASTRABOX_SANDBOX_ENDPOINT_SCHEME. Required in gateway mode.
#ASTRABOX_SANDBOX_SERVER_INGRESS_GATEWAY_ADDRESS=

# OpenSandbox endpoint mode for the bundled Kubernetes lifecycle server. Use
# direct only when AstraBox and its clients can route to sandbox Pod
# addresses. Use gateway for a multi-node deployment after installing the
# official OpenSandbox ingress component.
#ASTRABOX_SANDBOX_SERVER_INGRESS_MODE=direct

# OpenSandbox gateway routing mode for browser links: uri or wildcard.
# AstraBox refuses header mode because a normal browser navigation cannot
# supply its required OpenSandbox-Ingress-To header.
#ASTRABOX_SANDBOX_SERVER_INGRESS_ROUTE_MODE=uri

# Base64 signing secret for short-lived OpenSandbox browser URLs. Required
# when ASTRABOX_SANDBOX_SECURE_ACCESS=true and written only to the generated
# 0600 server.toml. Configure the same key on the separately deployed
# OpenSandbox ingress component.
#ASTRABOX_SANDBOX_SERVER_INGRESS_SIGNING_KEY=

# Path inside the AstraBox container to the kubeconfig used by the bundled
# OpenSandbox server. An empty value selects in-cluster ServiceAccount
# credentials. The file must be readable by the astrabox user; startup
# validates the credentials and Kubernetes API connection.
#ASTRABOX_SANDBOX_SERVER_KUBECONFIG=

# Kubernetes API server address to substitute into every cluster entry of the
# kubeconfig, for example https://10.0.1.7:6443. An empty value uses the
# address already present in the kubeconfig. Choose an address reachable from
# the container and covered by the API server certificate. AstraBox writes a
# 0600 derived copy beside server.toml and leaves the source file unchanged.
#ASTRABOX_SANDBOX_SERVER_KUBE_API_SERVER=

# Seconds the Kubernetes runtime waits for a new sandbox Pod to report an IP.
# Use a value of at least 1 and increase it for clusters that must add a node
# or pull a large Agent image before scheduling the Pod.
#ASTRABOX_SANDBOX_SERVER_KUBE_CREATE_TIMEOUT_SECONDS=60

# Existing Kubernetes namespace where OpenSandbox creates sandbox Pods. This
# workload namespace is separate from the controller namespace. Startup checks
# that it exists and reports the command for creating it when absent.
#ASTRABOX_SANDBOX_SERVER_KUBE_NAMESPACE=opensandbox

# Kubernetes resource used for each sandbox: batchsandbox selects
# batchsandboxes.sandbox.opensandbox.io; agent-sandbox selects
# sandboxes.agents.x-k8s.io. Startup validates the selected value and CRD.
#ASTRABOX_SANDBOX_SERVER_KUBE_WORKLOAD_PROVIDER=batchsandbox

# Writable directory for OpenSandbox metadata, expiration updates, generated
# server.toml, and any derived kubeconfig. The default is
# <state_dir>/opensandbox/metadata. Docker deployments persist this directory
# so renewed sandbox leases survive a service restart; Kubernetes stores
# renewal state in the workload resource.
#ASTRABOX_SANDBOX_SERVER_METADATA_DIR=

# Docker network mode for sandboxes the bundled lifecycle server creates when
# ASTRABOX_SANDBOX_SERVER_RUNTIME=docker. OpenSandbox's protected credential
# component requires bridge; that is a provider topology constraint, not a
# RuntimeProfile networking rule. The fixed sandbox service ports make host,
# container:<id>, and none invalid for this deployment layout.
#ASTRABOX_SANDBOX_SERVER_NETWORK_MODE=bridge

# Host port range ('min-max', both >= 1024, spanning >= 100) Docker publishes
# sandbox ports into. Each sandbox consumes 3 ports (execd, file server and
# egress API, all on its egress sidecar); narrow the range to match a firewall
# policy. Docker chooses each port itself in the host's network namespace: it
# skips ports it has published for any container and moves past ports a host
# process holds, trying up to ten per binding. Lifecycle servers that share
# one Docker daemon can therefore share the range. It must not overlap the
# kernel's ephemeral range (/proc/sys/net/ipv4/ip_local_port_range,
# 32768-60999 by default), where published ports and outgoing connections'
# source ports would contend for the same numbers; startup refuses an overlap
# it can read. The maintained Compose stack forwards this setting.
# ASTRABOX_SANDBOX_SERVER_RUNTIME=docker only — Kubernetes publishes no host
# ports at all.
#ASTRABOX_SANDBOX_SERVER_PORT_RANGE=20000-32000

# Runtime used by the bundled OpenSandbox lifecycle server: docker creates
# containers on the configured Docker daemon; kubernetes creates Pods through
# the selected OpenSandbox workload provider. ASTRABOX_SANDBOX_SERVER_KUBE_*
# settings apply to Kubernetes, while network mode, port range, PID limit, and
# publish-host settings apply to Docker.
#ASTRABOX_SANDBOX_SERVER_RUNTIME=docker

# Optional platform volume that durable workspace files are mounted from — a
# PersistentVolumeClaim on Kubernetes, a named volume on Docker. Each Agent
# conversation and each Assistant is a subPath under it, so one volume serves
# the deployment and a pooled box (created before the conversation that
# borrows it) can still carry it. Empty leaves workspace files on the
# sandbox's temporary filesystem. Workspace file persistence is separate from
# database-backed SessionStore recovery.
#ASTRABOX_SANDBOX_WORKSPACE_VOLUME=

# Scheduler provider that runs scheduled Deployments (cron dispatch, Run
# ledger, retries and recovery); 'none' disables scheduled Deployments, and
# startup then refuses while an enabled one is stored. The built-in 'dbos'
# keeps its state in the platform's PostgreSQL database. Other providers
# install through the astrabox.providers.scheduler entry-point group.
#ASTRABOX_SCHEDULER_PROVIDER=dbos

# Credential secret-store provider. local encrypts values in the product
# database under a persistent deployment key; aws_kms uses AWS KMS envelope
# encryption for stateless replicas. Unknown providers fail during startup.
#ASTRABOX_SECRET_STORE=local

# Host port the maintained local Compose deployment publishes AstraBox on
# (containers/compose.yaml maps 127.0.0.1:<this>:8000). The client subcommands
# derive their default endpoint from it, so moving the published port moves it
# for both. Distinct from ASTRABOX_PORT, which is the port the app binds
# inside the container.
#ASTRABOX_SERVER_HOST_PORT=8088

# CPU limit of an Agent's shared box (RuntimeProfile sandbox_tenancy=agent),
# as a Kubernetes quantity, for every such box. A shared box admits another
# conversation while its free memory allows, so its size decides how many it
# holds. A RuntimeProfile's sandbox_cpu replaces it for that profile's boxes,
# and caps their CPU request.
#ASTRABOX_SHARED_SANDBOX_CPU_LIMIT=4

# CPU request of an Agent's shared box. Startup refuses one above
# ASTRABOX_SHARED_SANDBOX_CPU_LIMIT.
#ASTRABOX_SHARED_SANDBOX_CPU_REQUEST=1

# Memory limit of an Agent's shared box, as a Kubernetes quantity. A
# RuntimeProfile's sandbox_memory replaces it, and the memory request, for
# that profile's boxes.
#ASTRABOX_SHARED_SANDBOX_MEMORY_LIMIT=4Gi

# Memory request of an Agent's shared box. Startup refuses one above
# ASTRABOX_SHARED_SANDBOX_MEMORY_LIMIT.
#ASTRABOX_SHARED_SANDBOX_MEMORY_REQUEST=4Gi

# Seconds to keep services available for in-flight work after /readyz turns
# not ready during shutdown. Kubernetes deployments pair this with preStop and
# a terminationGracePeriodSeconds longer than the drain window.
#ASTRABOX_SHUTDOWN_DRAIN_SECONDS=0

# JSON list of gateway transcription route names offered in voice input. The
# first is the default; empty disables voice input. Uses the existing model
# endpoint provider and session inference credentials.
#ASTRABOX_SPEECH_INPUT_MODELS=[]

# Private state directory for this Environment's generated keys, OpenSandbox
# metadata and local artifacts. Use a separate directory or volume for each
# Environment; retain its existing directory and keys during upgrades.
#ASTRABOX_STATE_DIR=./.astrabox

# Name of the registered storage provider that confirms a box's durable
# workspace arrived. Independent of ASTRABOX_SANDBOX_BACKEND — where a
# workspace lives is a durability decision, not a sandbox runtime one. Startup
# rejects unknown names. 'mounted_volume' supplies the deployment's backing
# filesystem; each sandbox backend's workspace route brings it into boxes (the
# OpenSandbox backend's through host mergerfs views), independently of the
# selected medium. 'aws_efs' verifies an operator-owned EFS CSI-backed PVC on
# Kubernetes. Additional providers can be installed through the
# astrabox.providers.storage entry-point group.
#ASTRABOX_STORAGE_PROVIDER=mounted_volume

# API key for title and process-summary requests. Empty uses the model
# endpoint provider's server credential (for LiteLLM:
# ASTRABOX_LITELLM_API_KEY, else LITELLM_MASTER_KEY), which is sent only to
# the gateway's own server-side address. Required when
# ASTRABOX_TITLE_MODEL_BASE_URL names any other endpoint.
#ASTRABOX_TITLE_MODEL_API_KEY=

# Name of the secret holding the title-generation model's API key.
#ASTRABOX_TITLE_MODEL_API_KEY_SECRET_NAME=

# Base URL of a separate model endpoint for titles and process summaries.
# Empty uses the model endpoint provider's server-side address (for LiteLLM:
# ASTRABOX_LITELLM_SERVER_BASE_URL, an external shared URL, or the embedded
# gateway's loopback), not the address sandboxes use. A URL that is not that
# address (compared by scheme, host, port and path) requires
# ASTRABOX_TITLE_MODEL_API_KEY or ASTRABOX_TITLE_MODEL_API_KEY_SECRET_NAME;
# startup refuses it without one.
#ASTRABOX_TITLE_MODEL_BASE_URL=

# Enable automatic conversation titles and process summaries. False sends no
# label-model requests; existing labels and normal Agent turns remain
# available. YAML: astrabox.title_model.enabled. Restart to apply.
#ASTRABOX_TITLE_MODEL_ENABLED=true

# Model route for titles and process summaries. Empty uses the deployment's
# default model. With DeepSeek's endpoint and the bundled gateway, the entry
# point sets it to the native deepseek/<model> route, which disables
# DeepSeek's thinking; point it at a non-thinking route for any provider whose
# route cannot.
#ASTRABOX_TITLE_MODEL_NAME=

# Positive, finite HTTPX network inactivity timeout in seconds for title
# requests. YAML: astrabox.title_model.request_timeout_seconds. Does not limit
# the whole Agent turn or add retries. Restart to apply.
#ASTRABOX_TITLE_MODEL_REQUEST_TIMEOUT_SECONDS=60

# Requires a per-Session capability token on sandbox-to-service transcript
# requests. A false value permits requests without this token and is intended
# only for network-isolated, single-tenant deployments.
#ASTRABOX_TRANSCRIPT_CAPABILITY_REQUIRED=true

# Shared secret keying the transcript capability HMAC (the tenant fence's
# trust root). Unset derives one (domain-separated) from
# ASTRABOX_VAULT_MASTER_KEY, else from the deployment master key generated
# once into <state_dir>/vault.key when ASTRABOX_SECRET_STORE=local — the zero-
# config single-node path. KMS-backed and other stateless deployments must set
# this variable to the same value on every replica.
#ASTRABOX_TRANSCRIPT_SIGNING_KEY=

# Header name carrying the user's email.
#ASTRABOX_TRUSTED_HEADER_EMAIL=x-forwarded-email

# Shared secret the proxy must present (in
# ASTRABOX_TRUSTED_HEADER_GATEWAY_SECRET_HEADER) to prove a request transited
# it; empty disables the check (forwarded headers are then trusted
# unconditionally).
#ASTRABOX_TRUSTED_HEADER_GATEWAY_SECRET=

# Header name the gateway secret is compared against.
#ASTRABOX_TRUSTED_HEADER_GATEWAY_SECRET_HEADER=x-astrabox-gateway-secret

# Header name carrying comma/whitespace-delimited group membership.
#ASTRABOX_TRUSTED_HEADER_GROUPS=x-forwarded-groups

# Header name carrying the user's display name.
#ASTRABOX_TRUSTED_HEADER_NAME=x-forwarded-preferred-username

# Header name carrying the org id; unset falls back to the deployment default
# org.
#ASTRABOX_TRUSTED_HEADER_ORG=

# Strict (default): a missing user header is a 401. Set an explicit falsey
# value (0/false/no/off) to fall through anonymous instead.
#ASTRABOX_TRUSTED_HEADER_STRICT=true

# Header name carrying the authenticated user id, forwarded by the SSO proxy
# (oauth2-proxy / Authelia / Authentik / Cloudflare Access).
#ASTRABOX_TRUSTED_HEADER_USER=x-forwarded-user

# Urlsafe-base64 32-byte AES-GCM master key for the local secret vault; unset
# auto-generates and atomically persists one at <state_dir>/vault.key (0600).
# Only consumed when ASTRABOX_SECRET_STORE=local; must be the SAME value on
# every replica when that provider is used in a multi-replica deployment.
#ASTRABOX_VAULT_MASTER_KEY=

# Freshness window (seconds) for signed webhook requests (the hmac scene and
# signed generic_json channel requests): a request whose X-WEBHOOK-TIMESTAMP
# is outside +/- this is rejected 401, so a captured (timestamp, signature,
# body) triple expires. The signature binds the body, so it also cannot be
# replayed with a different body.
#ASTRABOX_WEBHOOK_HMAC_WINDOW_SECONDS=300

# Identity profile for the web console and HTTP API: local, oidc, jwt, or
# trusted_header. Startup validates the selected name.
#ASTRABOX_WEB_IDENTITY=local

# Image built from containers/workspace-mounter/Dockerfile, used by the
# OpenSandbox backend's workspace route whenever
# ASTRABOX_SANDBOX_WORKSPACE_VOLUME is set; runs outside user sandboxes.
# Unset, it is the release image <ASTRABOX_IMAGE_PREFIX>workspace-
# mounter:<ASTRABOX_IMAGE_TAG>, which is published for amd64 only.
#ASTRABOX_WORKSPACE_MOUNTER_IMAGE=

# Host-side root for mergerfs mount entries and their control state. Separate
# from the backing workspace volume; never a user workspace.
#ASTRABOX_WORKSPACE_MOUNT_ROOT=/var/lib/astrabox/workspace-mounts

# Workspace storage topology: local for one sandbox host, shared for a
# filesystem shared by all eligible sandbox hosts. The OpenSandbox backend's
# mergerfs route rejects local storage on multi-node Kubernetes clusters.
#ASTRABOX_WORKSPACE_STORAGE_TOPOLOGY=local

# Provider API key for the bundled LiteLLM DeepSeek routes. When the single-
# endpoint setup points ANTHROPIC_BASE_URL at api.deepseek.com, the bundled
# gateway uses this credential for the DeepSeek route consumed by both
# supported client protocols.
#DEEPSEEK_API_KEY=

# Provider API key for the bundled LiteLLM Gemini routes. It is read directly
# by the bundled LiteLLM configuration, not by AstraBox code.
#GEMINI_API_KEY=

# Origin of the Langfuse deployment that receives the bundled gateway's
# traces, such as https://cloud.langfuse.com. Unset sends to Langfuse Cloud US
# (https://us.cloud.langfuse.com). Set without both Langfuse keys, it stops
# the gateway at startup.
#LANGFUSE_HOST=

# Langfuse project public key for the bundled gateway's model-call traces
# (LiteLLM's langfuse_otel logger). Traces are sent only when both Langfuse
# keys are set; one key without the other stops the gateway at startup.
#LANGFUSE_PUBLIC_KEY=

# Langfuse project secret key for the bundled gateway's model-call traces
# (LiteLLM's langfuse_otel logger). Traces are sent only when both Langfuse
# keys are set; one key without the other stops the gateway at startup.
#LANGFUSE_SECRET_KEY=

# Private service credential for the embedded LiteLLM gateway. The container
# entry point reads it and defaults the sandbox-facing provider credential to
# it. Empty = a value is generated once into <state_dir>/litellm.key (mode
# 0600). Multi-replica deployments must set the same value in every replica.
# LiteLLM's own name, not ASTRABOX_* — it is the proxy's variable, forwarded
# verbatim. The provider adapter uses the same credential for server-side
# model and extension operations.
#LITELLM_MASTER_KEY=

# Provider API key for the bundled LiteLLM OpenAI routes. It is read directly
# by the bundled LiteLLM configuration, not by AstraBox code.
#OPENAI_API_KEY=

# API key for the OpenAI-compatible service at OPENAI_COMPATIBLE_BASE_URL. It
# is read directly by the bundled LiteLLM configuration, not by AstraBox code.
#OPENAI_COMPATIBLE_API_KEY=

# Base URL of the OpenAI-compatible service behind the bundled LiteLLM route
# `openai-compatible/*`; an Agent selects `openai-compatible/<model id>`. Set
# it together with OPENAI_COMPATIBLE_API_KEY. It is read directly by the
# bundled LiteLLM configuration, not by AstraBox code.
#OPENAI_COMPATIBLE_BASE_URL=

# OTLP/HTTP endpoint for AstraBox request and orchestration spans. Setting the
# endpoint enables OpenTelemetry export; an empty value disables it. For
# Langfuse, use <LANGFUSE_HOST>/api/public/otel and let the exporter append
# /v1/traces.
#OTEL_EXPORTER_OTLP_ENDPOINT=

# Extra headers the OTLP exporter sends (W3C key=value,key2=value2), typically
# the Authorization=Basic <...> credential for a BYO Langfuse endpoint.
# Startup diagnostics report whether headers are configured while keeping
# their values redacted. This setting takes effect when
# OTEL_EXPORTER_OTLP_ENDPOINT is set.
#OTEL_EXPORTER_OTLP_HEADERS=

# service.name stamped on the OpenTelemetry Resource of every exported span,
# so this service is distinguishable in the tracing backend; defaults to
# 'astrabox' when unset. Only read when OTEL_EXPORTER_OTLP_ENDPOINT turns
# tracing on.
#OTEL_SERVICE_NAME=astrabox

# Alias of ASTRABOX_ENV used by YAML overlay selection and administrator
# diagnostics.
#SERVER_ENV=community
