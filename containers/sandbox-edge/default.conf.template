# This container is the only platform host an OpenSandbox workload is allowed
# to reach. Keep the upstreams fixed: accepting a destination from the request
# would turn this boundary into an SSRF proxy. The upstream is this project's
# AstraBox server, named by ASTRABOX_EDGE_UPSTREAM_HOST and reached over the
# private network the server connects this container to at startup. Docker's
# embedded DNS resolves the name per request, so nginx starts before that
# network is attached.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;
    set $astrabox_upstream ${ASTRABOX_EDGE_UPSTREAM_HOST};

    location / {
        proxy_http_version 1.1;
        proxy_pass http://$astrabox_upstream:80;
    }
}

server {
    listen 8000 default_server;
    server_name _;
    set $astrabox_upstream ${ASTRABOX_EDGE_UPSTREAM_HOST};

    location = /healthz {
        proxy_http_version 1.1;
        proxy_pass http://$astrabox_upstream:8000;
    }

    location ^~ /api/v1/platform-mcp/ {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_pass http://$astrabox_upstream:8000;
    }

    location ^~ /api/v1/sbxcap/ {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_pass http://$astrabox_upstream:8000;
    }

    location / {
        return 404;
    }
}
