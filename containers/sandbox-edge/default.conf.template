# This container is the only host an OpenSandbox workload is allowed to reach
# for local platform traffic. Keep the upstreams fixed: accepting a destination
# from the request would turn this boundary into an SSRF proxy.
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_http_version 1.1;
        proxy_pass http://host.docker.internal:${ASTRABOX_EDGE_MODEL_UPSTREAM_PORT};
    }
}

server {
    listen 8000 default_server;
    server_name _;

    location = /healthz {
        proxy_http_version 1.1;
        proxy_pass http://host.docker.internal:${ASTRABOX_EDGE_CALLBACK_UPSTREAM_PORT};
    }

    location ^~ /api/v1/platform-mcp/ {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_pass http://host.docker.internal:${ASTRABOX_EDGE_CALLBACK_UPSTREAM_PORT};
    }

    location ^~ /api/v1/sbxcap/ {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_pass http://host.docker.internal:${ASTRABOX_EDGE_CALLBACK_UPSTREAM_PORT};
    }

    location / {
        return 404;
    }
}
