# Local state dir (the default ASTRABOX_STATE_DIR "./.astrabox"): session
# workspaces, generated keys, and the bundled lifecycle server's server.toml.
# Running the test suite creates it, so leaving it untracked-but-not-ignored
# invites committing local state by accident.
.astrabox/
website/build/

# Box-rendered Caddyfile with inlined demo secret (never commit)
containers/caddy/Caddyfile.local
containers/caddy.env
frontend/test-results/
e2e/test-results-*/
